{
  "$schema": "https://json.schemastore.org/prettierrc",
  "semi": true,
  "singleQuote": false,
  "tabWidth": 2,
  "useTabs": false,
  "trailingComma": "all",
  "printWidth": 100,
  "arrowParens": "always",
  "endOfLine": "lf",
  "bracketSpacing": true,
  "plugins": ["prettier-plugin-tailwindcss", "prettier-plugin-tailwindcss-canonical-classes"],
  "tailwindStylesheet": "./web/src/styles.css",
  "tailwindcssCanonicalStylesheet": "./web/src/styles.css",
  "tailwindcssCanonicalRootFontSize": 14
}
