# Copy to .env for local development: cp .env.example .env
# Every setting is required. The server and the web dev server stop and name any that is missing.

# --- Server ---
# Address the Go server listens on.
SPARROW_LISTEN_ADDR=127.0.0.1:8090
# SQLite database file. Its folder must exist.
SPARROW_DATABASE_PATH=data/sparrow.db
# Address people open in the browser. Used in sign-in emails and cookie settings.
SPARROW_PUBLIC_URL=http://localhost:3000
# One of debug, info, warn, error.
SPARROW_LOG_LEVEL=debug
# Reverse proxies whose X-Forwarded-For header names the client, for per-IP rate limits:
# comma-separated IP addresses and CIDR ranges, or none when the server is reached directly.
SPARROW_TRUSTED_PROXIES=none

# --- Email (Resend) ---
# Sends sign-in codes and invitations. Create a key at https://resend.com/api-keys; it starts with re_.
SPARROW_RESEND_API_KEY=
# Sender of every email. Its domain must be verified in Resend.
SPARROW_EMAIL_FROM="Super Sparrow <onboarding@resend.dev>"
# Secret that sign-in codes are hashed with, at least 32 characters: openssl rand -hex 32. Keep it
# out of backups; changing it only cancels codes that are waiting to be entered.
SPARROW_SIGN_IN_CODE_KEY=

# --- Frontend ---
# Folder of the built frontend (web/dist after make build-web) that the server serves, or none
# when the web dev server serves it, as in development.
SPARROW_WEB_DIR=none

# --- GitHub webhook ---
# Secret of the GitHub webhook that closes an issue when its pull request merges, at least 20
# characters, or none to turn the webhook off.
SPARROW_GITHUB_WEBHOOK_SECRET=none

# --- Backups ---
# enabled or disabled. Enable them on any server that holds real data; each setting below is then
# required.
SPARROW_BACKUPS=disabled
# The age public key backups are encrypted to (age-keygen prints it). Keep the private key off the server.
# SPARROW_BACKUP_AGE_RECIPIENT=age1...
# UTC time of the daily backup, and how many days of daily backups to keep.
# SPARROW_BACKUP_DAILY_TIME=03:30
# SPARROW_BACKUP_KEEP_DAYS=30
# The Cloudflare R2 bucket and an API token's S3 credentials with read and write access to it.
# SPARROW_R2_ACCOUNT_ID=
# SPARROW_R2_ACCESS_KEY_ID=
# SPARROW_R2_SECRET_ACCESS_KEY=
# SPARROW_R2_BUCKET=

# --- Web development server ---
# Port of the Vite development server. It forwards /api to SPARROW_LISTEN_ADDR.
SPARROW_WEB_PORT=3000
