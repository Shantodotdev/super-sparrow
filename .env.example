# Copy to .env for local development: cp .env.example .env
# The server refuses to start when a setting it needs is missing or malformed, and names each one.
# Production needs every setting below. Development needs the ones not marked optional, and turns
# off each optional feature whose settings are left out.

# production or development.
APP_ENV=development

# --- Server ---
# Address the Go server listens on.
LISTEN_ADDR=127.0.0.1:8090
# SQLite database file. Its folder must exist.
DATABASE_PATH=data/sparrow.db
# Address people open in the browser. Used in sign-in emails and cookie settings. Production
# requires https://.
PUBLIC_URL=http://localhost:3000
# One of debug, info, warn, error.
LOG_LEVEL=debug
# Optional in development. Reverse proxies whose X-Forwarded-For header names the client, for
# per-IP rate limits: comma-separated IP addresses and CIDR ranges.
# TRUSTED_PROXIES=127.0.0.1

# --- Email (Resend) ---
# Sends sign-in codes and invitations. Create a key at https://resend.com/api-keys; it starts with re_.
RESEND_API_KEY=
# Sender of every email. Its domain must be verified in Resend.
EMAIL_FROM="Super Sparrow <onboarding@resend.dev>"
# Secret that sign-in codes are hashed with, at least 32 characters: openssl rand -hex 32.
# Changing it only cancels codes that are waiting to be entered.
SIGN_IN_CODE_KEY=

# --- Frontend ---
# Optional in development, where the web dev server serves the frontend. Folder of the built
# frontend (web/dist/client after make build-web) that the server serves.
# WEB_DIR=web/dist/client

# --- GitHub webhook ---
# Optional in development. Secret of the GitHub webhook that closes an issue when its pull request
# merges, at least 20 characters.
# GITHUB_WEBHOOK_SECRET=

# --- Backups ---
# Optional in development, but all or none: backups run when these are set. Key every backup is
# encrypted with, at least 32 characters; restoring needs the same key, so keep a copy in the
# team's password manager.
# BACKUP_ENCRYPTION_KEY=
# Time of day of the daily backup, the IANA time zone it is read in, which also dates each
# daily copy, and how many days of daily backups to keep.
# BACKUP_DAILY_TIME=03:00
# BACKUP_TIME_ZONE=Asia/Dhaka
# BACKUP_KEEP_DAYS=30
# The Cloudflare R2 bucket and an API token's S3 credentials with read and write access to it.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# --- Web development server ---
# Port of the Vite development server. It forwards /api to LISTEN_ADDR.
WEB_PORT=3000
