{
  "name": "super-sparrow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "web",
    "desktop"
  ],
  "scripts": {
    "format": "bun --bun prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml,css}\"",
    "format:check": "bun --bun prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml,css}\""
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "7.0.2"
  }
}
