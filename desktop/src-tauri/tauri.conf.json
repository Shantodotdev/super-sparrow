{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Super Sparrow",
  "version": "0.1.0",
  "identifier": "dev.shanto.supersparrow",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    },
    "enableGTKAppId": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "linux/super-sparrow.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/super-sparrow.desktop"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJBOTJEREQ2RDY1RDM4NTIKUldSU09GM1cxdDJTS2xadzZIMkhQYTBqOWRIc25ETjdFbFFjT2VSclVWZitOVWlwRUk0VHJET2YK",
      "endpoints": [
        "https://github.com/Shantodotdev/super-sparrow/releases/latest/download/latest.json"
      ]
    }
  }
}
